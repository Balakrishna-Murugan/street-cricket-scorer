# Example environment variables for the server
# Copy this file to `.env` in the server folder and fill in the real values.
# IMPORTANT: Do NOT commit your real `.env` file or credentials to source control.

# SMTP settings (for sending match summaries)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
# Replace the value below with your SMTP password; keep it secret and do not commit.
SMTP_PASS=YOUR_SENDGRID_SMTP_PASSWORD_HERE
SMTP_SECURE=false
EMAIL_FROM=you@yourdomain.com

# Other env examples (replace with your real values)
# MONGODB_URI=mongodb://localhost:27017/street-cricket
# PORT=4000

# Notes:
# - Create a local file at `server/.env` with the real values before starting the server.
# - On Windows PowerShell you can set per-session variables with `$env:SMTP_HOST = "..."` or
#   create `server/.env` and use your start script to load it.
# Server environment variables
PORT=5000
MONGODB_URI=mongodb://localhost:27017/street-cricket
NODE_ENV=development